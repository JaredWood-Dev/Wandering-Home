--- !u!114 &2051650845
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2051650841}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 05d812517dad0c34192412a304dccf42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueInteraction
  text:
    Sentences:
    - CurrentSpeaker: {fileID: 11400000, guid: ba68d1ed97c1f534898fb447ab4d89c3, type: 2}
      displaySpeaker: 0
      Sentence: A little late to be wandering around in the dark huh?
    - CurrentSpeaker: {fileID: 11400000, guid: d264785cf5cff9c458310d926bc1e615, type: 2}
      displaySpeaker: 0
      Sentence: Oh uh. I.. I'm just trying to go home.
    - CurrentSpeaker: {fileID: 11400000, guid: ba68d1ed97c1f534898fb447ab4d89c3, type: 2}
      displaySpeaker: 0
      Sentence: Well, just be safe out there.
    - CurrentSpeaker: {fileID: 11400000, guid: ba68d1ed97c1f534898fb447ab4d89c3, type: 2}
      displaySpeaker: 0
      Sentence: Those black scales and orange eyes. You remind me of someone.
    - CurrentSpeaker: {fileID: 11400000, guid: d264785cf5cff9c458310d926bc1e615, type: 2}
      displaySpeaker: 0
      Sentence: Oh uh.
    - CurrentSpeaker: {fileID: 11400000, guid: ba68d1ed97c1f534898fb447ab4d89c3, type: 2}
      displaySpeaker: 0
      Sentence: Have you heard of, oh what was his name. Jordgar I think?
    - CurrentSpeaker: {fileID: 11400000, guid: d264785cf5cff9c458310d926bc1e615, type: 2}
      displaySpeaker: 0
      Sentence: Yeah, He's my dad.
    - CurrentSpeaker: {fileID: 11400000, guid: ba68d1ed97c1f534898fb447ab4d89c3, type: 2}
      displaySpeaker: 0
      Sentence: So Jordgar had a son.
  dialogueManager: {fileID: 1760276276}
